                <objectAnimator android:propertyName="translateX" android:valueFrom="-20" android:valueTo="60" android:duration="10000" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="main_icon_group">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0.2083" android:valueTo="0.22" android:duration="3500" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0.2083" android:valueTo="0.22" android:duration="3500" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
