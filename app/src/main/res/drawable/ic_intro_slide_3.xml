        <target android:name="blob1">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="translateX" android:valueFrom="0" android:valueTo="80" android:duration="8000" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="translateY" android:valueFrom="50" android:valueTo="150" android:duration="9000" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="scaleX" android:valueFrom="1.0" android:valueTo="1.3" android:duration="7000" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="1.0" android:valueTo="1.3" android:duration="7000" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="blob2">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="translateY" android:valueFrom="100" android:valueTo="30" android:duration="10000" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="rotation" android:valueFrom="0" android:valueTo="45" android:duration="12000" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="blob3">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="translateX" android:valueFrom="400" android:valueTo="320" android:duration="11000" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="translateY" android:valueFrom="350" android:valueTo="420" android:duration="9500" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="scaleX" android:valueFrom="1.0" android:valueTo="1.4" android:duration="8500" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="1.0" android:valueTo="1.4" android:duration="8500" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
