<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="400dp"
            android:height="400dp"
            android:viewportWidth="500"
            android:viewportHeight="500">
            
                    <!-- Large soft circle drifting slowly -->
        <group android:name="blob1" android:translateX="0" android:translateY="50" android:pivotX="50" android:pivotY="50">
            <path android:pathData="M50,0 a50,50 0 1,1 0,100 a50,50 0 1,1 0,-100" android:fillColor="#FFFFFF" android:fillAlpha="0.15"/>
        </group>
        
        <!-- Pill shape rotating and floating -->
        <group android:name="blob2" android:translateX="350" android:translateY="100" android:pivotX="40" android:pivotY="80">
            <path android:pathData="M20,0 h40 a20,20 0 0,1 20,20 v120 a20,20 0 0,1 -20,20 h-40 a20,20 0 0,1 -20,-20 v-120 a20,20 0 0,1 20,-20 z" android:fillColor="#FFFFFF" android:fillAlpha="0.1"/>
        </group>

        <!-- Another circle at the bottom right -->
        <group android:name="blob3" android:translateX="400" android:translateY="350" android:pivotX="60" android:pivotY="60">
            <path android:pathData="M60,0 a60,60 0 1,1 0,120 a60,60 0 1,1 0,-120" android:fillColor="#FFFFFF" android:fillAlpha="0.2"/>
        </group>
        
        <!-- A floating curved element (half circle) -->
        <group android:name="blob4" android:translateX="-20" android:translateY="400" android:pivotX="50" android:pivotY="50">
            <path android:pathData="M50,0 a50,50 0 0,1 50,50 a50,50 0 0,1 -50,50 z" android:fillColor="#FFFFFF" android:fillAlpha="0.12"/>
        </group>
            
            <!-- Scale down the 960x960 icon (0 to 960 X, -960 to 0 Y) to fit in the center. -->
            <group android:name="main_icon_group" 
                   android:translateX="-230" 
                   android:translateY="730" 
                   android:scaleX="0.2083" 
                   android:scaleY="0.2083"
                   android:pivotX="480"
                   android:pivotY="-480">
                <path
                    android:pathData="M220-80q-24.75 0-42.37-17.63Q160-115.25 160-140v-434q0-24.75 17.63-42.38Q195.25-634 220-634h70v-96q0-78.85 55.61-134.42Q401.21-920 480.11-920q78.89 0 134.39 55.58Q670-808.85 670-730v96h70q24.75 0 42.38 17.62Q800-598.75 800-574v434q0 24.75-17.62 42.37Q764.75-80 740-80H220Zm0-60h520v-434H220v434Zm314.5-162.03Q557-324.06 557-355q0-30-22.67-54.5t-54.5-24.5q-31.83 0-54.33 24.5t-22.5 55q0 30.5 22.67 52.5t54.5 22q31.83 0 54.33-22.03ZM350-634h260v-96q0-54.17-37.88-92.08-37.88-37.92-92-37.92T388-822.08q-38 37.91-38 92.08v96ZM220-140v-434 434Z"
                    android:fillColor="#FFFFFF" />
            </group>
        </vector>
    </aapt:attr>
    
        <target android:name="blob1">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="translateX" android:valueFrom="0" android:valueTo="80" android:duration="8000" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="translateY" android:valueFrom="50" android:valueTo="150" android:duration="9000" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="scaleX" android:valueFrom="1.0" android:valueTo="1.3" android:duration="7000" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="1.0" android:valueTo="1.3" android:duration="7000" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="blob2">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="translateY" android:valueFrom="100" android:valueTo="30" android:duration="10000" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="rotation" android:valueFrom="0" android:valueTo="45" android:duration="12000" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="blob3">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="translateX" android:valueFrom="400" android:valueTo="320" android:duration="11000" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="translateY" android:valueFrom="350" android:valueTo="420" android:duration="9500" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="scaleX" android:valueFrom="1.0" android:valueTo="1.4" android:duration="8500" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="1.0" android:valueTo="1.4" android:duration="8500" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="blob4">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="rotation" android:valueFrom="-20" android:valueTo="20" android:duration="7500" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="translateX" android:valueFrom="-20" android:valueTo="60" android:duration="10000" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="main_icon_group">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0.2083" android:valueTo="0.22" android:duration="3500" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0.2083" android:valueTo="0.22" android:duration="3500" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
