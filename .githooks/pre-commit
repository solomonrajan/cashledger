#!/bin/sh
# Git pre-commit hook to automatically update KOTLIN_MIGRATION.mdx
# whenever .java or .kt files are committed.

CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACMRD | grep -E '\.(java|kt)$')

if [ -n "$CHANGED_FILES" ]; then
    echo "=========================================================="
    echo "Java/Kotlin file changes detected. Updating KOTLIN_MIGRATION.mdx..."
    echo "=========================================================="
    
    if command -v pwsh >/dev/null 2>&1; then
        pwsh -ExecutionPolicy Bypass -File ./scripts/Update-MigrationTracker.ps1
    elif command -v powershell >/dev/null 2>&1; then
        powershell -ExecutionPolicy Bypass -File ./scripts/Update-MigrationTracker.ps1
    else
        echo "Warning: PowerShell/pwsh not found; skipping tracker auto-update."
    fi
    
    if [ -f "KOTLIN_MIGRATION.mdx" ]; then
        git add KOTLIN_MIGRATION.mdx
        echo "KOTLIN_MIGRATION.mdx updated and staged."
    fi
fi

exit 0

