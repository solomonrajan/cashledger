#!/bin/sh
# Git pre-commit hook: Verify Kotlin null-safety rules (Zero double-bang '!!' policy)

CHANGED_KT_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.kt$')

if [ -n "$CHANGED_KT_FILES" ]; then
    FORBIDDEN=$(git diff --cached -S"!!" --name-only | grep -E '\.kt$')
    if [ -n "$FORBIDDEN" ]; then
        echo "=========================================================="
        echo "❌ Pre-commit check failed: Double-bang (!!) detected in:"
        echo "$FORBIDDEN"
        echo "=========================================================="
        echo "Cash Ledger enforces a strict zero-force-unwrap policy."
        echo "Please use safe calls (?.), elvis operator (?:), or checkNotNull()."
        exit 1
    fi
fi

exit 0

